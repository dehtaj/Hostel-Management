# SmartHostel local configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=smarthostel_management

# Generate a unique long value for local/prod use.
SECRET_KEY=replace-with-a-long-random-secret

# Local HTTP development: 0. Production HTTPS: 1
COOKIE_SECURE=0
FLASK_DEBUG=0

# Optional Razorpay test/live credentials
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
